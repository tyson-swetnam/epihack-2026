# Copy to .env and edit. The NWS public API has no token, but it
# *requires* a descriptive User-Agent that identifies the application
# and a contact (email or URL). Requests without one are rejected.
#
#   https://www.weather.gov/documentation/services-web-api
#
# Pattern: "<app-name> (<contact email or URL>)"
NWS_USER_AGENT=epihack-az-2026-sentinel (contact@example.org)

# Optional. Defaults below. Override if the NWS reorganizes endpoints
# or you want to point at a mirror / mock for development.
# NWS_BASE_URL=https://api.weather.gov

# Optional. The NWS HeatRisk (WPC) machine-readable feed URL.
# HeatRisk is an experimental product whose hosting location has drifted
# more than once; if the default 404s, override here and file an issue.
# Documented landing page: https://www.wpc.ncep.noaa.gov/heatrisk/
# NWS_HEATRISK_URL=https://www.wpc.ncep.noaa.gov/heatrisk/data/heatrisk.json

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# Path overrides for api.weather.gov. Defaults verified against the public
# documentation at https://www.weather.gov/documentation/services-web-api .
# Override here if the NWS reorganizes paths without a new client release.
# ---------------------------------------------------------------------------
# NWS_PATH_POINTS=/points/{lat},{lon}
# NWS_PATH_ALERTS_ACTIVE=/alerts/active
# NWS_PATH_STATIONS_FOR_POINT=/points/{lat},{lon}/stations
# NWS_PATH_STATION_OBSERVATIONS=/stations/{station_id}/observations/latest
# NWS_PATH_ZONE=/zones/{zone_type}/{zone_id}
