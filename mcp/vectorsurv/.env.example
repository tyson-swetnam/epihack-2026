# Copy to .env and fill in your VectorSurv Gateway credentials.
# Tokens expire hourly; the server refreshes automatically.
VECTORSURV_USERNAME=your_gateway_username
VECTORSURV_PASSWORD=your_gateway_password

# Optional. Defaults to https://api.vectorsurv.org. The spec also
# documents:
#   https://sandbox.api.vectorsurv.org/  (sandbox -- develop here)
#   https://dev.api.vectorsurv.org/      (development)
# VECTORSURV_BASE_URL=https://api.vectorsurv.org

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# Path overrides. Defaults verified against api.vectorsurv.org/openapi
# (spec v1.0.44). Override here if the spec drifts and the client hasn't
# been updated yet.
# ---------------------------------------------------------------------------
# VECTORSURV_PATH_LOGIN=/login
# VECTORSURV_PATH_VERSION=/version
# VECTORSURV_PATH_AGENCIES=/v1/agency
# VECTORSURV_PATH_AGENCY_REGION=/v1/agency-region-intersect
# VECTORSURV_PATH_SITES=/v1/site
# VECTORSURV_PATH_REGIONS=/v1/region
# VECTORSURV_PATH_REGION_TYPES=/v1/region/type
# VECTORSURV_PATH_ARTHRO_COLLECTION=/v1/arthropod/collection
# VECTORSURV_PATH_TICK_COLLECTION=/v1/tick/collection
# VECTORSURV_PATH_POOLS=/v1/arthropod/pool
# VECTORSURV_PATH_TICK_POOLS=/v1/tick/pool
# VECTORSURV_PATH_POOL_ARE_POSITIVE=/v1/arthropod/pool/are-positive
# VECTORSURV_PATH_ABUNDANCE_FLAT=/v1/arthropod/abundance/flat
# VECTORSURV_PATH_CASE_COUNT=/v1/case-count
# VECTORSURV_PATH_TEST_TARGET=/v1/test/target
# VECTORSURV_PATH_TEST_METHOD=/v1/test/method
# VECTORSURV_PATH_TICK_CALC_ABUND=/v1/tick/calculation/abundance
