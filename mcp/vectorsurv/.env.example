# Copy to .env and fill in your VectorSurv Gateway credentials.
# Tokens expire hourly; the server refreshes automatically.
VECTORSURV_USERNAME=your_gateway_username
VECTORSURV_PASSWORD=your_gateway_password

# Optional. Defaults to https://api.vectorsurv.org. Override to point
# at the VectorSurv Sandbox or a local proxy. The root URL itself is
# the Swagger UI -- inspect it to confirm the paths below match the
# live spec.
# VECTORSURV_BASE_URL=https://api.vectorsurv.org

# Optional path overrides. These defaults are inferred from the public
# vectorsurvR R package and docs.api.vectorsurv.org snippets; they are
# NOT verified against the live Swagger. If the Swagger UI at
# VECTORSURV_BASE_URL/ shows different paths, override them here
# without touching the code.
# VECTORSURV_PATH_LOGIN=/login
# VECTORSURV_PATH_AGENCIES=/agency
# VECTORSURV_PATH_SITES=/v1/site/
# VECTORSURV_PATH_COLLECTIONS=/v1/arthropod/collection
# VECTORSURV_PATH_POOLS=/v1/arthropod/pool

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio
