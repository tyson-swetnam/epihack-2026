# Copy to .env and source it. By default this server returns
# canned-data values (see ``src/adhs_mcp/canned_data.py``) -- ADHS does
# not publish a clean REST API today; surveillance reports are
# distributed as PDFs and ArcGIS dashboards. When a real backend ships
# (or a partner stands up a proxy), set the URL below and the client
# will route through it instead of the canned constants.
# ADHS_BACKEND_URL=https://adhs.example/api

# Optional bearer token for the future real backend.
# ADHS_API_TOKEN=changeme

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio
