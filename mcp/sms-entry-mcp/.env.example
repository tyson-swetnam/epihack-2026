# Copy to .env to flip the SMS server out of mock mode.

# 'mock' (default) keeps everything in-memory. 'twilio' enables real
# Twilio webhook verification. The MCP server tools never call out to
# Twilio directly -- the gateway HTTP service does that. The MCP server
# is only the intake state machine + signature verifier.
SMS_MODE=mock

# Required when SMS_MODE=twilio. Find this on the Twilio Console;
# rotate quarterly.
# SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your provisioned short code or long code (E.164).
# SMS_TWILIO_PHONE_NUMBER=+15555550199

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio

# Maximum SMS body length, in characters. Outbound prompts are already
# kept under 160 to fit a single SMS segment; raise only if your
# carrier supports concatenated SMS reliably.
# SMS_MAX_OUTBOUND_CHARS=160
