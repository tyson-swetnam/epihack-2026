# Copy to .env and fill in your wearable backend credentials.
# wearable-mcp is mock-by-default for the Phase 4 demo; the real
# backend is the on-device store that app/shared/wearable.js
# populates from HealthKit / Health Connect.

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted Claude.ai custom connector).
# MCP_TRANSPORT=stdio

# Optional streamable-HTTP wiring (only honored when
# MCP_TRANSPORT=streamable-http). Match the path to the nginx
# `location` block (see ansible/roles/nginx + the mcp_http_servers
# list in ansible/group_vars/all.yml).
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8014
# FASTMCP_STREAMABLE_HTTP_PATH=/mcp/wearable

# Optional. Switch to a non-mock backend (TBD; the on-device adapters
# are the only real backends today).
# WEARABLE_BACKEND=mock
