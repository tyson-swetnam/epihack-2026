{
  "_comment": "Paste the 'vectorsurv' block into your Claude Desktop config under mcpServers. Restart Claude Desktop after editing.",
  "mcpServers": {
    "vectorsurv": {
      "command": "uvx",
      "args": ["--from", "/absolute/path/to/epihack-2026/mcp/vectorsurv-mcp", "vectorsurv-mcp"],
      "env": {
        "VECTORSURV_USERNAME": "your_gateway_username",
        "VECTORSURV_PASSWORD": "your_gateway_password",
        "VECTORSURV_BASE_URL": "https://api.vectorsurv.org"
      }
    }
  }
}
