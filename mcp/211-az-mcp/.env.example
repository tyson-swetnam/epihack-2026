# Copy to .env and edit.
#
# 211 Arizona (operated by Solari Crisis & Human Services) does not
# publish a public REST API at time of writing. This MCP server ships
# a sensible MOCK backend (see src/az211_mcp/mock_data.py) so the
# end-to-end agent flows in plan/04-data-flows.md (in particular
# Scenario C, the unsheltered heat check-in) run offline.
#
# When a real API arrives, point this at it and the client will swap
# transparently. Until then it is fine to leave AZ211_BACKEND_URL
# unset; the server uses the in-memory mock backend.
# AZ211_BACKEND_URL=https://api.example.211arizona.org

# Optional. Bearer token for the real backend, when it exists.
# AZ211_API_KEY=

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio
