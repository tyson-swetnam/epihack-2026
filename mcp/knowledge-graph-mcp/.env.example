# Copy to .env and edit. All values are optional -- the defaults make
# the server work against the in-repo schema with no extra config.

# Default 'stdio' (Claude Desktop / Code) or 'streamable-http'
# (hosted deployment).
# MCP_TRANSPORT=stdio

# Where to find the seed schema files. Defaults to ../../schema
# relative to this package, i.e. the in-repo schema/ directory.
# KG_SCHEMA_PATH=/absolute/path/to/epihack-2026/schema

# Attach a real DuckLake catalog instead of seeding an in-memory DuckDB.
# When set, KG_SCHEMA_PATH is ignored.
# KG_DUCKLAKE_URI=ducklake:postgres:dbname=epihack host=localhost user=epihack
# KG_DUCKLAKE_DATA_PATH=s3://epihack/ducklake/
