# Copy to .env and source it. The iNaturalist API requires a
# meaningful User-Agent on every request; the server refuses to
# start without one. Include a contact (email or URL) so iNat can
# reach you if your traffic causes a problem.
INAT_USER_AGENT=epihack-az-2026/0.1 (contact: ops@example.org)

# Optional. Defaults to https://api.inaturalist.org/v1
# INAT_BASE_URL=https://api.inaturalist.org/v1

# Optional. Set to 1 to force the canned-data fallback (no HTTP
# requests will be made). Useful for offline development + CI.
# INAT_OFFLINE=0

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# Place + taxon ID overrides. iNaturalist IDs are stable but
# new contributors may want to patch them without a code change.
# Defaults are documented in `src/inaturalist_mcp/canned_data.py`.
# ---------------------------------------------------------------------------
# INAT_AZ_PLACE_ID=53                          # US state of Arizona

# INAT_TAXON_TICKS=47119                       # Order Ixodida
# INAT_TAXON_MOSQUITOES=84738                  # Family Culicidae
# INAT_TAXON_FLEAS=84377                       # Order Siphonaptera
# INAT_TAXON_RODENTS=43698                     # Order Rodentia

# INAT_TAXON_RHIPICEPHALUS_SANGUINEUS=84219    # Brown dog tick
# INAT_TAXON_DERMACENTOR_ANDERSONI=126099      # Rocky Mountain wood tick
# INAT_TAXON_DERMACENTOR_VARIABILIS=84223      # American dog tick
# INAT_TAXON_IXODES_PACIFICUS=62366            # Western black-legged tick

# INAT_TAXON_PEROMYSCUS_MANICULATUS=46559      # Deer mouse (hantavirus)
# INAT_TAXON_CYNOMYS_GUNNISONI=46211           # Gunnison's prairie dog (plague)
# INAT_TAXON_OTOSPERMOPHILUS_VARIEGATUS=73704  # Rock squirrel (plague)
# INAT_TAXON_SYLVILAGUS_AUDUBONII=43130        # Desert cottontail (tularemia)

# ---------------------------------------------------------------------------
# Endpoint-path overrides. Defaults verified against
# https://api.inaturalist.org/v1/docs/.
# ---------------------------------------------------------------------------
# INAT_PATH_OBSERVATIONS=/observations
# INAT_PATH_TAXA=/taxa
# INAT_PATH_TAXA_AUTOCOMPLETE=/taxa/autocomplete
# INAT_PATH_PLACES=/places
