# Copy to .env and source it. By default this server uses an in-memory
# mock backend (no network calls). When the UA Cooperative Extension /
# Walker lab eventually ships an HTTP submission API, set this to point
# at it and the client will stop using the mock.
# GATTC_BACKEND_URL=https://great-arizona-tick-check.example/api

# Optional bearer token for the future real backend.
# GATTC_API_TOKEN=changeme

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio

# ---------------------------------------------------------------------------
# Submission UX defaults — surfaced to callers as part of every
# `gattc_create_submission` response. Override to tune turnaround
# estimates without a code change.
# ---------------------------------------------------------------------------
# GATTC_TURNAROUND_DAYS=21

# Public mailing-label image base. The mock returns
# `${GATTC_LABEL_BASE}/{submission_id}.{fmt}`. The real backend will
# typically return a signed URL of its own.
# GATTC_LABEL_BASE=https://great-arizona-tick-check.example/labels

# Public status-page base. The mock returns
# `${GATTC_STATUS_BASE}/{submission_id}`.
# GATTC_STATUS_BASE=https://great-arizona-tick-check.example/submissions
