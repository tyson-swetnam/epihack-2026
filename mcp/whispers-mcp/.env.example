# Copy to .env and adjust as needed. The public WHISPers read endpoints
# do NOT require credentials -- the EventViewSet/EventSummary endpoints
# automatically restrict anonymous callers to events flagged `public=True`.
# Credentials would only be needed if a future tool calls write or
# admin-only endpoints.

# Optional. Defaults to https://whispers.usgs.gov/api. This is the
# api_root the production Angular frontend uses (see
# USGS-WiM/whispers src/environments/environment.prod.ts).
# The backing Django service codebase lives at
# https://github.com/USGS-WiM/whispersservices (archived; active mirror
# at https://code.usgs.gov/WiM/whispersservices).
# WHISPERS_BASE_URL=https://whispers.usgs.gov/api

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio

# Optional. Force the offline canned-event dataset even when the
# upstream is reachable. Useful for hermetic CI runs or demos.
# WHISPERS_USE_MOCK=1

# Optional. Disable the silent live-API fallback to canned data;
# tools will surface upstream errors instead of degrading.
# WHISPERS_DISABLE_FALLBACK=1

# ---------------------------------------------------------------------------
# Path overrides. Defaults derived from the URL router in
# whispersapi/urls.py (USGS-WiM/whispersservices). The DRF router
# registers each viewset as `/api/<basename>/`.
# ---------------------------------------------------------------------------
# WHISPERS_PATH_EVENTS=/events
# WHISPERS_PATH_EVENT_SUMMARIES=/eventsummaries
# WHISPERS_PATH_EVENT_DETAILS=/eventdetails
# WHISPERS_PATH_EVENT_TYPES=/eventtypes
# WHISPERS_PATH_EVENT_LOCATIONS=/eventlocations
# WHISPERS_PATH_SPECIES=/species
# WHISPERS_PATH_DIAGNOSES=/diagnoses
# WHISPERS_PATH_ADMIN_L1=/administrativelevelones
# WHISPERS_PATH_ADMIN_L2=/administrativeleveltwos
