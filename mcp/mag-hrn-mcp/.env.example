# Copy to .env and source it. By default this server uses a small
# canned dataset of ~12 realistic Phoenix-metro sites (Burton Barr,
# Andre House, Mesa Main Library, Tempe Public, Glendale Main,
# Scottsdale Civic Center, etc.). No network calls are made until you
# point it at a real ArcGIS feature service.
#
# The public storefront is https://hrn.azmag.gov/, backed by a MAG-
# hosted ArcGIS service at:
#
#   https://geo.azmag.gov/arcgis/rest/services/maps/Heat_Relief_Network
#
# That URL has drifted between seasons (MapServer vs FeatureServer; the
# specific layer index for cooling/respite/hydration/donation has
# moved); set this env var to the active service root and the client
# will switch from the canned dataset to live data.
# MAG_HRN_FEATURE_SERVICE_URL=https://geo.azmag.gov/arcgis/rest/services/maps/Heat_Relief_Network/MapServer

# Layer index inside the feature service. Set to "all" to walk every
# advertised layer (the MAG service has historically split sites across
# per-type layers; "all" is the safest default once you've flipped to
# live mode).
# MAG_HRN_FEATURE_LAYER=all

# Optional bearer token. The public HRN service is anonymous today; an
# operator-only or partner-only feed might require auth.
# MAG_HRN_API_TOKEN=

# Optional. 'stdio' (default, for Claude Desktop / Code) or
# 'streamable-http' (for a hosted deployment).
# MCP_TRANSPORT=stdio
