# Copy to .env.local and fill in the real values. Never commit .env.local.
#
# Supabase Auth (plan/07-auth.md). When unset, the auth UI renders in
# "configure-me" mode and anonymous reporting still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Intake API base. 'mock' short-circuits to bundled fixtures; set to
# your FastAPI deploy origin to talk to a real backend.
NEXT_PUBLIC_API_BASE=mock
