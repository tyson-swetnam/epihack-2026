# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.env
!.env.example

# Build / dist
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/

# uv
.uv-cache/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (in case the prototype app picks up tooling later)
node_modules/
.next/
out/
.vercel/

# Jekyll output (Pages publishes from source; never commit _site)
_site/
.jekyll-cache/
.sass-cache/

# MkDocs build output (Pages publishes from source; never commit site/)
/site/

# Backups created by Claude during the archival rewrite (Phase 1).
# Original is in git history; we don't need a sibling .bak file too.
*.bak

# Local data
*.duckdb
*.duckdb.wal
ducklake-data/

# Generated synthetic-report artifacts (markdown + images for offline demo);
# the durable DuckLake batch is the source of truth, see scripts/export_signals.py.
/synthetic_dataset/
/generate_dataset.py

# Logs
*.log

# Local Claude Code settings
.claude/
# stray encrypted-vault backups
*.encrypted.bak

# --- Claude Code local settings & MCP configs (may contain secrets) ---
# See the claude-project-template repo ("Claude Project Gitignore").
.claude/settings.local.json
.claude/*.local.json
.claude/*.local.md
CLAUDE.local.md
.mcp.json
.claude/mcp.json
/claude_desktop_config.json
