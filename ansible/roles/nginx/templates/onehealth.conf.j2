# Generated by ansible/roles/nginx. Do not edit by hand.
#
# Two upstreams:
#   /            → static Next.js export at {{ onehealth_repo_path }}/app/out
#   /api/        → uvicorn on 127.0.0.1:{{ fastapi_bind_port }}
#
# When tls_enabled is true, certbot rewrites this file in place to
# add the SSL block and a 301 redirect from :80.

server {
    listen 80;
    listen [::]:80;
    server_name {{ onehealth_fqdn }};

    # Security headers (also re-applied on the :443 server when TLS lands).
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY"    always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(self), camera=(self), microphone=()" always;

    # ---- API ---------------------------------------------------------------
    location /api/ {
        proxy_pass         http://127.0.0.1:{{ fastapi_bind_port }}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 25M;        # photo uploads
    }

    # ---- Static Next.js export --------------------------------------------
    root  {{ onehealth_repo_path }}/app/out;
    index index.html;

    # Long-cache the immutable Next.js asset chunks.
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        # Next.js static export emits /report/human/, etc. as directories
        # with index.html inside. Try the path, then the path-with-slash,
        # then fall back to /index.html (single-page-app behaviour).
        try_files $uri $uri/ $uri.html /index.html;
    }
}
