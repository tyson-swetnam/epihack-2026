# Generated by ansible/roles/nginx. Do not edit by hand.
#
# Two upstreams:
#   /            → static Next.js export at {{ onehealth_repo_path }}/app/out
#   /api/        → uvicorn on 127.0.0.1:{{ fastapi_bind_port }}
#
# When tls_enabled is true, certbot rewrites this file in place to
# add the SSL block and a 301 redirect from :80.

server {
    listen 80;
    listen [::]:80;
    server_name {{ onehealth_fqdn }};

    # Security headers (also re-applied on the :443 server when TLS lands).
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY"    always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "geolocation=(self), camera=(self), microphone=()" always;

    # ---- API ---------------------------------------------------------------
    location /api/ {
        proxy_pass         http://127.0.0.1:{{ fastapi_bind_port }}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 25M;        # photo uploads
    }

    # ---- Static Next.js export --------------------------------------------
    root  {{ onehealth_repo_path }}/app/out;
    index index.html;

    # Long-cache the immutable Next.js asset chunks.
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

{% if serve_query_console | default(true) %}
    # ---- DuckDB-WASM query console ----------------------------------------
    # Browser-side SQL viewer (Jekyll page under {{ onehealth_repo_path }}/query).
    # DuckDB-WASM is loaded client-side from pinned jsDelivr (like MapLibre /
    # Cytoscape), so there is no server package — we only serve the static page
    # and the schema/*.sql seeds it fetches to rebuild the kg.* graph in-page.
    # These prefix locations are more specific than `location /`, so they win.
    location /query/ {
        alias {{ onehealth_repo_path }}/query/;
        index index.html;
    }

    location /schema/ {
        alias {{ onehealth_repo_path }}/schema/;
        # .sql isn't in the default mime map; serve it as readable text so the
        # browser fetch() in the viewer gets a sensible Content-Type.
        types { text/plain sql; }
        default_type text/plain;
    }
{% endif %}

{% if serve_dashboard | default(true) %}
    # ---- Signal-monitor dashboard (browser-side) --------------------------
    # Static Jekyll page at {{ onehealth_repo_path }}/dashboard/, including
    # dashboard/signals/index.html + dashboard/shared/signal-monitor.js +
    # dashboard/data/signals.json (refreshed by scripts/export_signals.py).
    # On GitHub Pages this is served from gh-pages; this block makes it
    # reachable on the live VM too. More specific than `location /`, so it wins.
    location /dashboard/ {
        alias {{ onehealth_repo_path }}/dashboard/;
        index index.html;
        try_files $uri $uri/ =404;
    }
{% endif %}

{% if serve_docs | default(true) %}
    # ---- MkDocs documentation site (static) -------------------------------
    # Built by the `docs` role to {{ onehealth_repo_path }}/site via
    # `mkdocs build` (mkdocs.yml site_dir: site). On GitHub Pages this same
    # tree is published to gh-pages/docs/ by deploy-docs.yml; this block makes
    # it reachable on the live VM too. MkDocs emits relative internal links, so
    # one build serves correctly at both /epihack-2026/docs/ (Pages) and /docs/
    # (here). More specific than `location /`, so it wins.
    location /docs/ {
        alias {{ onehealth_repo_path }}/site/;
        index index.html;
        try_files $uri $uri/ =404;
    }
{% endif %}

{% for srv in mcp_http_servers | default([]) %}
    # ---- {{ srv.name }}-mcp remote endpoint (Claude.ai custom connector) ---
    # FastMCP streamable-HTTP server on 127.0.0.1:{{ srv.port }}, serving its
    # full public path so nginx proxies it through unchanged. Run it with
    # FASTMCP_STREAMABLE_HTTP_PATH={{ srv.path }} (see the server's README).
    # SSE-style long-lived stream: disable buffering, raise the read timeout.
    location {{ srv.path }} {
        proxy_pass            http://127.0.0.1:{{ srv.port }};
        proxy_http_version    1.1;
        proxy_set_header      Host              $host;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_set_header      Connection        "";
        proxy_buffering       off;
        proxy_read_timeout    3600s;
        chunked_transfer_encoding on;
    }
{% endfor %}

    location / {
        # Next.js static export emits /report/human/, etc. as directories
        # with index.html inside. Try the path, then the path-with-slash,
        # then fall back to /index.html (single-page-app behaviour).
        try_files $uri $uri/ $uri.html /index.html;
    }
}
