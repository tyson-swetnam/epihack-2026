# Generated by ansible/roles/fastapi. Re-run the playbook to update.
ONEHEALTH_BUILD={{ ansible_date_time.iso8601 }}
ONEHEALTH_CORS_ALLOWED_ORIGINS={{ fastapi_cors_origins }}
ONEHEALTH_AUTH_MOCK={{ fastapi_auth_mock }}
SUPABASE_URL={{ vault_supabase_jwks_url | regex_replace('/auth/v1/jwks$', '') }}
SUPABASE_JWT_SECRET={{ vault_supabase_jwt_secret }}
DATABASE_URL=postgresql://{{ postgres_db_user }}:{{ vault_postgres_password }}@{{ postgres_listen }}/{{ postgres_db_name }}
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
# DuckLake knowledge-graph lakehouse (Postgres catalog + local Parquet).
# The reports write-path and the audit sink persist here.
KG_DUCKLAKE_URI={{ ducklake_uri }}
KG_DUCKLAKE_DATA_PATH={{ ducklake_data_path }}
KG_SCHEMA_PATH={{ onehealth_repo_path }}/schema
