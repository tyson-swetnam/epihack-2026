# Managed by ansible/roles/mongodb. Re-run the playbook to update.
storage:
  dbPath: /var/lib/mongodb
systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log
net:
  port: 27017
  bindIp: {{ mongodb_bind }}
processManagement:
  timeZoneInfo: /usr/share/zoneinfo
security:
  authorization: enabled
