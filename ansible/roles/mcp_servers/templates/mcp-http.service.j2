[Unit]
# Generated by ansible/roles/mcp_servers. Do not edit by hand.
# Runs a FastMCP server in streamable-HTTP mode so nginx can proxy it as a
# Claude.ai custom connector. See ansible/group_vars/all.yml's mcp_http_servers
# list and ansible/roles/nginx/templates/onehealth.conf.j2's location block.
Description=AZ One Health — {{ item.name }}-mcp (streamable HTTP, Claude.ai connector)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ onehealth_user }}
Group={{ onehealth_group }}
WorkingDirectory={{ onehealth_repo_path }}/mcp/{{ item.name }}-mcp
Environment=PYTHONUNBUFFERED=1
Environment=MCP_TRANSPORT=streamable-http
Environment=FASTMCP_HOST=127.0.0.1
Environment=FASTMCP_PORT={{ item.port }}
Environment=FASTMCP_STREAMABLE_HTTP_PATH={{ item.path }}
EnvironmentFile=-/etc/onehealth-mcp-{{ item.name }}.env
ExecStart={{ onehealth_repo_path }}/mcp/{{ item.name }}-mcp/.venv/bin/python -m {{ mcp_modules.get(item.name + '-mcp', (item.name + '-mcp') | replace('-', '_')) }}
Restart=on-failure
RestartSec=3s

# Hardening — mirror the onehealth-api.service posture.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ onehealth_root }}

[Install]
WantedBy=multi-user.target
