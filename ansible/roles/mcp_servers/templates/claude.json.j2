{
  "_comment": "Generated by ansible/roles/mcp_servers. Do not edit by hand; re-run the playbook.",
  "projects": {
    "{{ onehealth_repo_path }}": {
      "mcpServers": {
{% set comma = joiner(",") %}
{% for name in mcp_servers %}
{%- set pkg = mcp_modules.get(name, name | replace('-', '_')) %}
{{ comma() }}        "{{ name }}": {
          "command": "{{ onehealth_repo_path }}/mcp/{{ name }}/.venv/bin/python",
          "args": ["-m", "{{ pkg }}"],
          "env": {
{% if name == 'vectorsurv-mcp' %}
            "VECTORSURV_USERNAME": "{{ vault_vectorsurv_username }}",
            "VECTORSURV_PASSWORD": "{{ vault_vectorsurv_password }}"
{% elif name == 'great-az-tick-check-mcp' %}
            "GATTC_API_TOKEN": "{{ vault_gattc_api_token }}"
{% elif name == 'adhs-mcp' %}
            "ADHS_API_TOKEN": "{{ vault_adhs_api_token }}"
{% elif name == '211-az-mcp' %}
            "AZ211_API_KEY": "{{ vault_az211_api_key }}"
{% elif name == 'sms-entry-mcp' %}
            "SMS_TWILIO_AUTH_TOKEN": "{{ vault_sms_twilio_auth_token }}",
            "SMS_MODE": "{{ sms_mode }}"
{% elif name == 'knowledge-graph-mcp' %}
            "KG_DUCKLAKE_URI": "{{ ducklake_uri }}",
            "KG_DUCKLAKE_DATA_PATH": "{{ ducklake_data_path }}",
            "KG_SCHEMA_PATH": "{{ onehealth_repo_path }}/schema"
{% elif name == 'inaturalist-mcp' %}
            "INAT_USER_AGENT": "{{ inat_user_agent }}"
{% elif name == 'nws-heatrisk-mcp' %}
            "NWS_USER_AGENT": "{{ nws_user_agent }}"
{% else %}
            "PYTHONUNBUFFERED": "1"
{% endif %}
          }
        }
{% endfor %}
      }
    }
  }
}
